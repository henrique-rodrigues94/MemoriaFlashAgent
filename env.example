# =============================================================================
# FIREBASE ADMIN SDK — obrigatório em produção
# =============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =============================================================================
# PROVEDORES DE IA — GEMINI é o principal; os demais são fallback
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=32768

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=25000

# =============================================================================
# PRODUÇÃO / SEGURANÇA
# =============================================================================
# Em produção deve ser true. O Agent falha fechado se secrets/limites essenciais faltarem.
CONTENT_AGENT_PRODUCTION_STRICT=false
CONTENT_AGENT_ENABLED=true
CONTENT_AGENT_TIMEZONE=America/Campo_Grande
CONTENT_AGENT_SCHEDULE="0 3 * * 0"

# =============================================================================
# CONTENT AGENT
# =============================================================================
CONTENT_AGENT_SUBJECTS=
CONTENT_AGENT_DIFFICULTY=medium
CONTENT_AGENT_MIN_CARDS=20
CONTENT_AGENT_TARGET_CARDS=60
CONTENT_AGENT_MAX_CARDS=150
CONTENT_AGENT_CARD_TYPES=definition,quiz
CONTENT_AGENT_MAX_RUNTIME_MIN=25
CONTENT_AGENT_MAX_CARDS_PER_RUN=500
CONTENT_AGENT_MAX_AI_CALLS=50
CONTENT_AGENT_MAX_TOPICS=20
CONTENT_AGENT_MAX_RETRIES=2
CONTENT_AGENT_REQUEST_TIMEOUT_MIN=120
CONTENT_AGENT_BATCH_SIZE=20
CONTENT_AGENT_MAX_CARDS_REVIEWED=5
CONTENT_AGENT_MAX_REQUESTS=2
CONTENT_AGENT_MAX_REQUEST_TOPICS=12
CONTENT_AGENT_CARD_MIN_FEEDBACK=5
CONTENT_AGENT_CARD_MIN_NEGATIVE_RATE=0.5
CONTENT_AGENT_MIN_FEEDBACK=20
CONTENT_AGENT_MIN_NEGATIVE=5
CONTENT_AGENT_MIN_NEGATIVE_RATE=0.3
CONTENT_AGENT_QUALITY_MIN=0.72
CONTENT_AGENT_GROUNDING_MIN=0.18
CONTENT_AGENT_QUALITY_RETRIES=1
