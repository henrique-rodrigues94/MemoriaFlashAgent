          "id": "medio.portugues.linguagem-e-comunicacao.funcoes-da-linguagem.funcoes-da-linguagem.af9f47f1.0001",
          "level": "medio",
          "subject": "portugues",
          "curriculum": "Linguagem e comunicação",
          "topic": "Funções da linguagem",
          "subtopic": "Funções da linguagem",
          "front": "O que caracteriza referencial — referencial [af9f47f1-0001]?",
          "back": "Prioriza a informação sobre fatos, objetos ou situações.",
          "explanation": "O conceito não deve ser decorado isoladamente: sua função fica mais clara quando observada em exemplos e situações reais.",
          "curiosity": "Curiosidade: Prioriza a informação sobre fatos, objetos ou situações.",
          "difficulty": "easy",
          "contentHash": "a2581f0e531d5151a9a8e4b3021347528efb25bf6faedd368d6a0a60103b30bc"
