NODE_ENV=development

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin Dashboard — mantenha o dashboard privado
ADMIN_DASHBOARD_HOST=127.0.0.1
ADMIN_DASHBOARD_PORT=8787
ADMIN_DASHBOARD_TOKEN=troque-por-um-token-longo

# Referência de armazenamento/quota — não substitui a medição oficial do Google Cloud
FIRESTORE_FREE_STORAGE_BYTES=1073741824
FIRESTORE_FREE_WRITES_PER_DAY=20000

# Alimentador .mflash
CONTENT_IMPORT_STRATEGY=sync
CONTENT_IMPORT_MAX_BYTES=52428800
CONTENT_IMPORT_MAX_STORAGE_PERCENT=95
CONTENT_IMPORT_MAX_WRITES_PER_RUN=15000
CONTENT_IMPORT_MIN_CARDS_PER_SUBTOPIC=1
CONTENT_IMPORT_SIMILARITY_THRESHOLD=0.92
CONTENT_IMPORT_MAX_SIMILARITY_CANDIDATES=200

# IA — configure somente os provedores utilizados
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_MODEL=

# Agent
CONTENT_AGENT_ENABLED=true
CONTENT_AGENT_PRODUCTION_STRICT=true
CONTENT_AGENT_DISCOVERY_ENABLED=false
CONTENT_AGENT_CLEANUP_ENABLED=false
CONTENT_AGENT_CLEANUP_APPLY=false
CONTENT_AGENT_TIMEZONE=America/Campo_Grande
